; Gold SND EA Preset Settings
; Copy this file to MQL5/Profiles/ folder

[Gold_SND_Conservative]
; Conservative settings for low risk trading
EA_Name=Gold SND EA - Conservative
Magic_Number=12345
Lot_Size=0.01
Max_Orders=5
Max_Lot=0.5
SND_Lookback=100
SND_Threshold=0.001
Zone_Expiry=48
Averaging_Multiplier=1.2
Averaging_Step=0.0005
Max_Averaging=3
Enable_Hedging=true
Hedging_Trigger=-50
Hedging_Lot=0.01
Stop_Loss=0.008
Take_Profit=0.015
Max_Floating=200

